<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd http://www.exoplatform.org/xml/ns/kernel_1_3.xsd"
  xmlns="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd">

  <external-component-plugins>
    <target-component>org.exoplatform.commons.upgrade.UpgradeProductService</target-component>
    <component-plugin>
      <name>MyApplicationsPortletInstancePermissionUpgrade</name>
      <set-method>addUpgradePlugin</set-method>
      <type>io.meeds.appcenter.plugin.upgrade.MyApplicationsPortletInstancePermissionUpgradePlugin</type>
      <description>Let whoever may edit a page add a Shortcuts portlet to it</description>
      <init-params>
        <value-param>
          <name>product.group.id</name>
          <value>org.exoplatform.social</value>
        </value-param>
        <value-param>
          <name>plugin.execution.order</name>
          <value>5</value>
        </value-param>
        <!-- No target version: execute.once is the run-once gate -->
        <value-param>
          <name>plugin.upgrade.execute.once</name>
          <value>true</value>
        </value-param>
        <!-- Required: the plugin waits for the server startup, which is refused on the startup thread -->
        <value-param>
          <name>plugin.upgrade.async.execution</name>
          <value>true</value>
        </value-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

</configuration>
