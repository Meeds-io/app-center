<portlet-app version="2.0"
  xmlns="http://java.sun.com/xml/ns/portlet/portlet-app_2_0.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://java.sun.com/xml/ns/portlet/portlet-app_2_0.xsd http://java.sun.com/xml/ns/portlet/portlet-app_2_0.xsd">
  <!-- ================================================================ -->
  <!-- = App Center Admin Setup Portlet = -->
  <!-- ================================================================== -->
  <portlet>
    <portlet-name>AppCenterAdminSetupPortlet</portlet-name>
    <display-name xml:lang="EN">App center admin setup portlet</display-name>
    <portlet-class>io.meeds.appcenter.portlet.AdminSetupPortlet</portlet-class>
    <init-param>
      <name>preload.resource.bundles</name>
      <value>locale.addon.appcenter</value>
    </init-param>
    <init-param>
      <name>preload.resource.rest</name>
      <value>/app-center/rest/settings</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
      <portlet-mode>edit</portlet-mode>
    </supports>
    <portlet-info>
      <title>App center admin setup portlet</title>
      <keywords>App center portlets</keywords>
    </portlet-info>
    <portlet-preferences>
      <preference>
        <name>pageSize</name>
        <value>10</value>
        <read-only>false</read-only>
      </preference>
    </portlet-preferences>
  </portlet>
  <!-- ================================================================ -->
  <!-- = App Center User Setup Portlet = -->
  <!-- ================================================================== -->
  <portlet>
    <portlet-name>AppCenterUserSetupPortlet</portlet-name>
    <display-name xml:lang="EN">App center user setup portlet</display-name>
    <portlet-class>io.meeds.appcenter.portlet.UserSetupPortlet</portlet-class>
    <init-param>
      <name>prefetch.resource.bundles</name>
      <value>locale.addon.appcenter</value>
    </init-param>
    <init-param>
      <name>prefetch.resource.rest</name>
      <value><![CDATA[/app-center/rest/settings,/app-center/rest/applications?offset=0&limit=12&keyword=,/app-center/rest/favorites]]></value>
    </init-param>
    <init-param>
      <name>layout-css-class</name>
      <value>no-layout-background-color no-layout-border-radius no-layout-border</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
      <portlet-mode>edit</portlet-mode>
    </supports>
    <portlet-info>
      <title>App center user setup portlet</title>
      <keywords>App center portlets</keywords>
    </portlet-info>
    <portlet-preferences>
      <preference>
        <name>pageSize</name>
        <value>10</value>
        <read-only>false</read-only>
      </preference>
    </portlet-preferences>
  </portlet>
  <!-- ================================================================ -->
  <!-- = App center My Applications Portlet = -->
  <!-- ================================================================== -->
  <portlet>
    <portlet-name>AppCenterMyApplicationsPortlet</portlet-name>
    <display-name xml:lang="EN">App center my applications portlet</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/html/myApplications.html</value>
    </init-param>
    <init-param>
      <name>preload.resource.bundles</name>
      <value>locale.addon.appcenter</value>
    </init-param>
    <init-param>
      <name>preload.resource.rest</name>
      <value>/app-center/rest/settings,/app-center/rest/favorites</value>
    </init-param>
    <expiration-cache>-1</expiration-cache>
    <cache-scope>PUBLIC</cache-scope>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <portlet-info>
      <title>App center my applications portlet</title>
      <keywords>App center portlets</keywords>
    </portlet-info>
    <portlet-preferences>
    </portlet-preferences>
  </portlet>
  <!-- ================================================================ -->
  <!-- = App Center App Launcher Portlet = -->
  <!-- ================================================================== -->
  <portlet>
    <portlet-name>AppCenterAppLauncherPortlet</portlet-name>
    <display-name xml:lang="EN">App center app launcher portlet</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/WEB-INF/jsp/appCenter/appLauncher.jsp</value>
    </init-param>
    <init-param>
      <name>layout-css-class</name>
      <value>no-layout-style</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.addon.appcenter</resource-bundle>
    <portlet-info>
      <title>App center app launcher portlet</title>
      <keywords>App center portlets</keywords>
    </portlet-info>
  </portlet>
  <portlet>
    <portlet-name>QuickActions</portlet-name>
    <display-name xml:lang="EN">Quick Actions</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/html/quickActions.html</value>
    </init-param>
    <expiration-cache>-1</expiration-cache>
    <cache-scope>PUBLIC</cache-scope>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.QuickActions</resource-bundle>
    <portlet-info>
      <title>App Center Quick Actions</title>
      <keywords>Quick Actions</keywords>
    </portlet-info>
  </portlet>
  <portlet>
    <portlet-name>UserQuickActions</portlet-name>
    <display-name xml:lang="EN">User Preferred Quick Actions</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/WEB-INF/jsp/userQuickActions.jsp</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.QuickActions</resource-bundle>
    <portlet-info>
      <title>User Preferred Quick Actions</title>
      <keywords>Quick Actions</keywords>
    </portlet-info>
  </portlet>
</portlet-app>
